---
import Layout from '../../layouts/Layout.astro'
import ResourcesSubnav from '../../components/ResourcesSubnav.astro'
---

<Layout title="Resources - Garret James Hokr" description="A free guide to breaking into the sports industry, plus my free advice.">
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-10 text-center">
    <h1 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight">Resources</h1>
    <p class="mt-4 text-lg text-ink-soft">Guides and advice for breaking into the sports industry.</p>
  </section>

  <ResourcesSubnav />

  <section class="mx-auto max-w-2xl px-6 py-16">
    <div class="mt-8 flex flex-col items-center gap-6 overflow-hidden rounded-lg border border-gold-dark/20 bg-white/50 px-6 py-10 sm:flex-row sm:items-center sm:text-left text-center">
      <img
        src="/images/four-pillars-cover.png"
        alt="The 4 Pillars: How I Broke Into the Sports Industry — guide cover"
        class="aspect-[1188/1836] w-40 shrink-0 rounded-lg object-cover shadow-sm"
      />
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-gold-dark">Career</span>
        <h2 class="mt-2 font-serif text-2xl font-semibold">The 4 Pillars: How I Broke Into the Sports Industry</h2>
        <p class="mt-2 text-sm text-ink-soft leading-relaxed">
          A free 39-page guide to breaking into the sports industry, the things I wish someone had told me before I started.
        </p>
        <div class="mt-6 flex justify-center sm:justify-start">
          <a
            href="/guides/four-pillars"
            class="rounded-md bg-ink px-5 py-3 text-sm font-semibold text-cream transition-colors hover:bg-gold-deep"
          >
            Get the free guide →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
