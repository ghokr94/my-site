---
import Layout from '../../layouts/Layout.astro'

const pillars = [
  {
    n: '01',
    name: 'Passion',
    tagline: "When even the boring parts excite you, that's when you know.",
  },
  {
    n: '02',
    name: 'Practice',
    tagline: 'The experience you already have counts more than you think, but you still have to go and put in the work.',
  },
  {
    n: '03',
    name: 'People',
    tagline: "The right people help you believe in yourself and put you in a position to find what's next.",
  },
  {
    n: '04',
    name: 'Persistence',
    tagline: 'Rejection is data telling you where to go next.',
  },
]
---

<Layout
  title="The 4 Pillars — Free Guide | Garret James Hokr"
  description="A free 39-page guide to breaking into the sports industry, the things I wish someone had told me before I started."
>
  <section class="mx-auto max-w-2xl px-6 pt-16 pb-10 text-center">
    <span class="text-xs font-semibold uppercase tracking-widest text-gold-dark">Free Guide</span>
    <h1 class="mt-2 font-serif text-4xl sm:text-5xl font-semibold tracking-tight">
      The 4 Pillars: How I Broke Into the Sports Industry
    </h1>
    <p class="mt-4 text-lg italic text-ink-soft">With no degree, no connections, and no straight line.</p>

    <img
      src="/images/four-pillars-cover.png"
      alt="The 4 Pillars: How I Broke Into the Sports Industry — guide cover"
      class="mx-auto mt-10 aspect-[1188/1836] w-56 rounded-lg object-cover shadow-md"
    />

    <p class="mx-auto mt-10 max-w-md leading-relaxed text-ink-soft">
      A free 39-page guide to breaking into the sports industry, the things I wish someone had told me before I started.
    </p>

    <div class="mt-8 flex justify-center">
      <script async data-uid="3f5e4ccdaf" src="https://garretjames.kit.com/3f5e4ccdaf/index.js" is:inline data-astro-rerun></script>
      <script is:inline data-astro-rerun>
        (function () {
          function setLabels() {
            var spans = document.querySelectorAll('.formkit-form[data-uid="3f5e4ccdaf"] .formkit-submit span')
            spans.forEach(function (span) {
              span.textContent = 'Get the free guide 🏈⚽⚾🏀🏒'
            })
          }
          setLabels()
          var observer = new MutationObserver(setLabels)
          observer.observe(document.body, { childList: true, subtree: true })
        })()
      </script>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-16 border-t border-gold-dark/20">
    <div class="text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-gold-dark">Contents</span>
      <h2 class="mt-2 font-serif text-3xl font-semibold tracking-tight">What's Inside</h2>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {pillars.map((pillar) => (
        <div class="rounded-2xl border border-gold-dark/20 bg-white/50 p-8 shadow-sm">
          <span class="font-serif text-4xl font-semibold text-gold-dark/40">{pillar.n}</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold">{pillar.name}</h3>
          <p class="mt-3 leading-relaxed text-ink-soft">{pillar.tagline}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-2xl px-6 py-16 border-t border-gold-dark/20 text-center">
    <div class="mx-auto w-40 h-40 rounded-full border border-gold-dark/20 overflow-hidden bg-[#e2d5b5]">
      <img
        src="/images/garret.png"
        alt="Garret James Hokr"
        class="w-full h-full object-cover scale-150 translate-y-[16%]"
      />
    </div>
    <p class="mx-auto mt-6 max-w-md leading-relaxed text-ink-soft">
      My name's Garret James Hokr. I broke into the sports industry in my late twenties after a few career-changes, no specialized bachelor's degree, and zero connections. From pouring beers behind the bar, to working the front offices of sports organizations across the US and abroad, I write for the dreamers trying to break into the most fun industry in the world.
    </p>
    <img
      src="/images/signature.jpg"
      alt="Garret James Hokr signature"
      class="mx-auto mt-4 w-40 mix-blend-multiply"
    />
  </section>

  <section class="mx-auto max-w-2xl px-6 py-16 border-t border-gold-dark/20 text-center">
    <h2 class="font-serif text-3xl font-semibold tracking-tight">Get your free copy</h2>
    <p class="mx-auto mt-4 max-w-md leading-relaxed text-ink-soft">
      The 4 Pillars, delivered straight to your inbox. No degree, no connections, no straight line required.
    </p>
    <div class="mt-8 flex justify-center">
      <script async data-uid="3f5e4ccdaf" src="https://garretjames.kit.com/3f5e4ccdaf/index.js" is:inline data-astro-rerun></script>
    </div>
  </section>
</Layout>

<style is:global>
  /* Override Kit's default blue theme on the 4 Pillars form to match the site palette.
     Kit sets colors via inline style attributes, so !important is required to win. */
  .formkit-form[data-uid="3f5e4ccdaf"] .formkit-input {
    background: rgba(255, 255, 255, 0.7) !important;
    border-color: rgba(153, 124, 89, 0.3) !important;
    color: #191510 !important;
  }
  .formkit-form[data-uid="3f5e4ccdaf"] .formkit-input:focus {
    border-color: #cca677 !important;
  }
  .formkit-form[data-uid="3f5e4ccdaf"] .formkit-submit,
  .formkit-form[data-uid="3f5e4ccdaf"] .formkit-button {
    background-color: #191510 !important;
    color: #f2e9d8 !important;
  }
  .formkit-form[data-uid="3f5e4ccdaf"] .formkit-submit:hover,
  .formkit-form[data-uid="3f5e4ccdaf"] .formkit-button:hover {
    background-color: #7e6649 !important;
  }
  .formkit-form[data-uid="3f5e4ccdaf"] .formkit-powered-by-convertkit {
    background-image: none !important;
    width: auto !important;
    height: auto !important;
    text-indent: 0 !important;
    overflow: visible !important;
    color: rgba(74, 66, 56, 0.5) !important;
    font-size: 10px !important;
    text-decoration: none !important;
  }
</style>
