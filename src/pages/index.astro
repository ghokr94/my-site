---
import Layout from '../layouts/Layout.astro'
import EmailCapture from '../components/EmailCapture.astro'

const whySubscribe = [
  {
    title: 'Real career-pivot stories',
    body: 'No polished highlight reel — the actual jobs, dead ends, and lucky breaks that add up to a career change.',
  },
  {
    title: 'Advice for breaking into sports',
    body: 'Practical, unglamorous lessons on where the real entry points are and how to actually get noticed.',
  },
  {
    title: 'One story a week, not a firehose',
    body: 'A single weekly issue worth reading in full, instead of another daily inbox obligation.',
  },
]
---

<Layout title="Garret James Hokr - Sports, Side-questing, and Social Impact">
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-gold-dark">
      Tales from a Serial Side-Quester
    </p>
    <h1 class="wipe-in mt-3 font-serif text-4xl sm:text-5xl font-semibold tracking-tight leading-tight">
      Weekly stories about chasing a career in sports.
    </h1>
    <p class="mt-5 text-lg text-ink-soft">
      Starting from scratch, welcoming wanderlust, and enjoying the ride along the way.
    </p>
    <div class="mt-8 flex justify-center">
      <EmailCapture align="center" />
    </div>
    <p class="mt-3 text-xs text-ink-soft">One story a week. No spam. Unsubscribe anytime.</p>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16 border-t border-gold-dark/20">
    <div class="grid sm:grid-cols-3 gap-8">
      {whySubscribe.map((item) => (
        <div>
          <h3 class="font-serif text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm text-ink-soft leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16 border-t border-gold-dark/20">
    <h2 class="font-serif text-2xl font-semibold">Latest issue</h2>
    <div class="mt-6 rounded-lg border border-dashed border-gold-dark/40 bg-cream-dim/60 px-8 py-12 text-center">
      <p class="font-serif text-xl font-medium">Issue #1 — coming soon</p>
      <p class="mt-2 text-sm text-ink-soft">The first issue is on its way. Subscribe above to get it the day it drops.</p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16 border-t border-gold-dark/20 flex flex-col sm:flex-row items-center sm:items-start gap-8">
    <div class="w-40 h-40 sm:w-56 sm:h-56 shrink-0 rounded-lg border border-gold-dark/20 overflow-hidden bg-[#e2d5b5]">
      <img
        src="/images/garret.png"
        alt="Garret James Hokr"
        class="w-full h-full object-cover scale-150 translate-y-[16%]"
      />
    </div>
    <div>
      <h2 class="font-serif text-2xl font-semibold">About Garret James</h2>
      <p class="mt-3 text-ink-soft leading-relaxed max-w-xl">
        From pouring drinks behind the bar to working the front offices of pro sports franchises. I climbed every level, worked inside Kroenke Sports & Entertainment (the group behind the LA Rams and Arsenal), and consulted for a pro league on the other side of the world. Now, I write about breaking into the industry when you've got no straight line and no obvious way in.
      </p>
      <a href="/about" class="mt-4 inline-block text-sm font-semibold text-gold-dark hover:text-gold-deep transition-colors">Read more &rarr;</a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 border-t border-gold-dark/20 text-center">
    <h2 class="font-serif text-2xl font-semibold">One story, every week.</h2>
    <p class="mt-2 text-ink-soft">Join the readers figuring out their own side quest.</p>
    <div class="mt-6 flex justify-center">
      <EmailCapture align="center" />
    </div>
  </section>
</Layout>
