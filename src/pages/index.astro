---
import Layout from '../layouts/Layout.astro'
import EmailCapture from '../components/EmailCapture.astro'

const whySubscribe = [
  {
    title: 'Real career-pivot stories',
    body: 'No polished highlight reel — the actual jobs, dead ends, and lucky breaks that add up to a career change.',
  },
  {
    title: 'Advice for breaking into sports',
    body: 'Practical, unglamorous lessons on where the real entry points are and how to actually get noticed.',
  },
  {
    title: 'One story a week, not a firehose',
    body: 'A single weekly issue worth reading in full, instead of another daily inbox obligation.',
  },
]
---

<Layout title="Garret James Hokr - Sports, Side-questing, and Social Impact">
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-20 text-center">
    <p class="text-base font-semibold uppercase tracking-widest text-gold-dark">
      Dream Job: Sports
    </p>
    <h1 class="wipe-in mt-4 font-serif text-[clamp(2.25rem,4.2vw,3.5rem)] font-semibold tracking-tight leading-tight">
      Weekly stories about chasing a career in sports.
    </h1>
    <p class="mt-6 text-xl text-ink-soft">
      Starting from scratch, welcoming wanderlust, and enjoying the ride along the way.
    </p>
    <div class="mt-10 flex justify-center">
      <EmailCapture align="center" />
    </div>
    <p class="mt-4 text-sm text-ink-soft">One story a week. No spam. Unsubscribe anytime.</p>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 border-t border-gold-dark/20">
    <div class="grid sm:grid-cols-3 gap-10">
      {whySubscribe.map((item) => (
        <div>
          <h3 class="font-serif text-xl font-semibold">{item.title}</h3>
          <p class="mt-3 text-base text-ink-soft leading-relaxed">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 border-t border-gold-dark/20">
    <h2 class="font-serif text-3xl font-semibold">Latest issue</h2>
    <div class="mt-8 rounded-lg border border-dashed border-gold-dark/40 bg-cream-dim/60 px-8 py-12 text-center">
      <p class="font-serif text-2xl font-medium">Issue #1 — coming soon</p>
      <p class="mt-3 text-base text-ink-soft">The first issue is on its way. Subscribe above to get it the day it drops.</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-20 border-t border-gold-dark/20 flex flex-col sm:flex-row items-center gap-10">
    <div class="w-44 h-44 sm:w-64 sm:h-64 shrink-0 rounded-lg border border-gold-dark/20 overflow-hidden bg-[#e2d5b5]">
      <img
        src="/images/garret.png"
        alt="Garret James Hokr"
        class="w-full h-full object-cover scale-150 translate-y-[16%]"
      />
    </div>
    <div>
      <h2 class="font-serif text-3xl font-semibold">About me</h2>
      <p class="mt-4 text-lg text-ink-soft leading-relaxed max-w-xl">
        From pouring drinks behind the bar to working the front offices of pro sports franchises. I climbed every level, worked inside Kroenke Sports & Entertainment (the group behind the LA Rams and Arsenal), and consulted for a pro league on the other side of the world. Now, I write about breaking into the industry when you've got no straight line and no obvious way in.
      </p>
      <a href="/about" class="mt-5 inline-block text-base font-semibold text-gold-dark hover:text-gold-deep transition-colors">Read more &rarr;</a>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 py-24 border-t border-gold-dark/20 text-center">
    <h2 class="font-serif text-[clamp(1.75rem,3.2vw,2.375rem)] font-semibold">One story, every week.</h2>
    <p class="mt-3 text-base text-ink-soft">Join the readers chasing their dream job in sports.</p>
    <div class="mt-8 flex justify-center">
      <EmailCapture align="center" />
    </div>
  </section>
</Layout>
