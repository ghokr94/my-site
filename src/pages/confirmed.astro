<Layout title="Confirmed - Garret James Hokr" description="You're subscribed to Tales from a Serial Side-Quester.">
  <section class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="font-serif text-4xl font-semibold tracking-tight">You're in.</h1>
    <p class="mt-4 text-ink-soft leading-relaxed">
      Thanks for confirming — you'll get the next issue of <em>Tales from a Serial Side-Quester</em> the moment it drops. In the meantime, feel free to read <a href="/about" class="font-semibold text-gold-dark hover:text-gold-deep transition-colors">my story</a>, poke around the <a href="/archive" class="font-semibold text-gold-dark hover:text-gold-deep transition-colors">Archive</a>, or check out what other <a href="/resources" class="font-semibold text-gold-dark hover:text-gold-deep transition-colors">Resources</a> I have to offer.
    </p>
  </section>
</Layout>
