---
import Layout from '../layouts/Layout.astro'
import EmailCapture from '../components/EmailCapture.astro'
---

<Layout title="Archive — Tales from a Serial Side-Quester">
  <section class="mx-auto max-w-2xl px-6 py-20 text-center">
    <h1 class="font-serif text-4xl font-semibold tracking-tight">Archive</h1>
    <p class="mt-4 text-ink-soft leading-relaxed">
      No issues published yet — this is where every past monthly issue will live once the newsletter launches. Subscribe now and you won't miss issue #1.
    </p>
    <div class="mt-8 flex justify-center">
      <EmailCapture align="center" />
    </div>
  </section>
</Layout>
