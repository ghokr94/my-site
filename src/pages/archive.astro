---
import Layout from '../layouts/Layout.astro'
import EmailCapture from '../components/EmailCapture.astro'
---

<Layout title="Archive - Garret James Hokr">
  <section class="mx-auto max-w-2xl px-6 pt-16 pb-20 text-center">
    <h1 class="font-serif text-[clamp(2.25rem,4.2vw,3.5rem)] font-semibold tracking-tight leading-tight">Archive</h1>
    <p class="mt-4 text-xl text-ink-soft leading-relaxed">
      No issues published yet — this is where every past weekly issue will live once the newsletter launches. Subscribe now and you won't miss issue #1.
    </p>
    <div class="mt-8 flex justify-center">
      <EmailCapture align="center" />
    </div>
  </section>
</Layout>
