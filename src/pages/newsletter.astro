---
import Layout from '../layouts/Layout.astro'
import EmailCapture from '../components/EmailCapture.astro'
import { getChapters, formatDate } from '../lib/chapters'

const chapters = await getChapters()
---

<Layout title="Newsletter - Garret James Hokr">
  <section class="mx-auto max-w-2xl px-6 pt-16 pb-20 text-center">
    <h1 class="font-serif text-[clamp(2.25rem,4.2vw,3.5rem)] font-semibold tracking-tight leading-tight">Newsletter</h1>
    <p class="mt-4 text-xl text-ink-soft leading-relaxed">
      {chapters.length > 0
        ? 'Every chapter of Dream Job: Sports, all in one place. Subscribe to get the next one in your inbox.'
        : "Every chapter of Dream Job: Sports will live here once it's published. Subscribe now and you won't miss Chapter 1."}
    </p>
    <div class="mt-8 flex justify-center">
      <EmailCapture align="center" />
    </div>

    {chapters.length > 0 ? (
      <ul class="mt-12 flex flex-col gap-4 text-left">
        {chapters.map((chapter) => (
          <li>
            <a
              href={`/newsletter/${chapter.id}`}
              class="block rounded-2xl border border-gold-dark/20 bg-white/50 p-8 shadow-sm transition-colors hover:border-gold"
            >
              <p class="text-xs font-semibold uppercase tracking-widest text-gold-dark">
                Chapter {chapter.data.chapter} · {formatDate(chapter.data.date)}
                {chapter.data.draft && <span class="ml-2 text-gold-deep">(Draft)</span>}
              </p>
              <h2 class="mt-2 font-serif text-2xl font-semibold">{chapter.data.title}</h2>
              <p class="mt-3 leading-relaxed text-ink-soft">{chapter.data.description}</p>
              <p class="mt-4 text-sm font-semibold text-gold-dark">Read it &rarr;</p>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-12 rounded-lg border border-dashed border-gold-dark/40 bg-cream-dim/60 px-8 py-12 text-center">
        <p class="font-serif text-2xl font-medium">Chapter #1 - Coming soon</p>
        <p class="mt-3 text-base text-ink-soft">"Dream Job: Sports - Chapter 1" drops this Saturday. Once it's out, you'll be able to read it here.</p>
      </div>
    )}
  </section>
</Layout>
