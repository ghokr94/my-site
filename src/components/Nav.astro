---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/archive', label: 'Archive' },
  { href: '/resources', label: 'Resources' },
]
const current = Astro.url.pathname
---

<header class="border-b border-gold-dark/20">
  <nav class="mx-auto max-w-5xl px-6 py-5 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <span
        role="img"
        aria-label="Garret James Hokr"
        class="h-10 w-10 rounded-full bg-no-repeat"
        style="background-image: url(/images/garret.png); background-size: 153% auto; background-position: 50% 12%; background-color: #e2d5b5;"
      ></span>
      <span class="font-serif text-lg font-semibold tracking-tight">
        Garret James Hokr
      </span>
    </a>
    <ul class="flex items-center gap-6 text-sm font-medium">
      {links.map((link) => {
        const isActive = link.href === '/' ? current === '/' : current.startsWith(link.href)
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                'transition-colors hover:text-gold-dark',
                isActive ? 'text-ink' : 'text-ink-soft',
              ]}
            >
              {link.label}
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
</header>
