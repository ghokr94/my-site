---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/archive', label: 'Archive' },
  { href: '/resources', label: 'Resources' },
]
const current = Astro.url.pathname
---

<header class="border-b border-gold-dark/20">
  <nav class="mx-auto max-w-5xl px-6 py-5 flex items-center justify-between gap-6">
    <a href="/" class="font-serif text-lg font-semibold tracking-tight shrink-0">
      Garret James Hokr
    </a>
    <ul class="flex items-center gap-6 text-sm font-medium">
      {links.map((link) => {
        const isActive = link.href === '/' ? current === '/' : current.startsWith(link.href)
        return (
          <li>
            <a
              href={link.href}
              class:list={[
                'transition-colors hover:text-gold-dark',
                isActive ? 'text-ink' : 'text-ink-soft',
              ]}
            >
              {link.label}
            </a>
          </li>
        )
      })}
    </ul>
  </nav>
</header>
