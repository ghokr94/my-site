---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/archive', label: 'Archive' },
  { href: '/resources', label: 'Resources' },
]
const current = Astro.url.pathname
const isLinkActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href))
---

<header class="border-b border-gold-dark/20">
  <nav class="mx-auto max-w-5xl px-6 py-5 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <span
        role="img"
        aria-label="Garret James Hokr"
        class="h-10 w-10 rounded-full bg-no-repeat shrink-0"
        style="background-image: url(/images/garret.png); background-size: 153% auto; background-position: 50% 12%; background-color: #e2d5b5;"
      ></span>
      <span class="font-serif text-base sm:text-lg font-semibold tracking-tight">
        Garret James Hokr
      </span>
    </a>

    <ul class="hidden sm:flex items-center gap-6 text-sm font-medium">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'transition-colors hover:text-gold-dark',
              isLinkActive(link.href) ? 'text-ink' : 'text-ink-soft',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <details class="relative sm:hidden">
      <summary class="nav-summary flex items-center justify-center p-2 -mr-2 cursor-pointer list-none" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6 text-ink">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <ul class="absolute right-0 top-full mt-2 w-48 rounded-lg border border-gold-dark/20 bg-cream shadow-lg p-2 flex flex-col gap-1 z-50 text-sm font-medium">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'block rounded-md px-3 py-2 transition-colors hover:bg-gold/15 hover:text-gold-dark',
                isLinkActive(link.href) ? 'text-ink' : 'text-ink-soft',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
</header>

<style>
  .nav-summary::-webkit-details-marker {
    display: none;
  }
</style>
