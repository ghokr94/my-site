---
const tabs = [
  { href: '/resources', label: 'Free Advice' },
  { href: '/resources/professions', label: 'My Professions' },
  { href: '/resources/work-with-me', label: 'Work With Me' },
]
const current = Astro.url.pathname
---

<div class="mx-auto max-w-5xl px-6 pt-4">
  <div class="flex gap-2 border-b border-gold-dark/20">
    {tabs.map((tab) => {
      const isActive = current === tab.href
      return (
        <a
          href={tab.href}
          class:list={[
            'px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors',
            isActive
              ? 'border-gold text-ink'
              : 'border-transparent text-ink-soft hover:text-gold-dark',
          ]}
        >
          {tab.label}
        </a>
      )
    })}
  </div>
</div>
